# ==========================================
# RELAY AI - Environment Configuration
# ==========================================

# Database: PostgreSQL with pgvector
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay

# GitHub Ingestion (Personal Access Token with public_repo read access)
GITHUB_TOKEN=your_github_token_here

# LLM Providers (Specify at least one)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Demo / Resilience Settings
REPLAY_MODE=false
REPLAY_CACHE_PATH=/tmp/relay_replay_cache.json

# Web Frontend (optional override if not using reverse proxy)
# VITE_API_URL=http://localhost:8000

