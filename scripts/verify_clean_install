#!/usr/bin/env bash
# ==============================================================================
# RELAY AI — Clean Install & Smoke Test Verification Script
# Clones repository to an isolated temporary directory, builds frontend,
# launches the backend on an isolated port, and verifies critical endpoints.
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
REPO_ROOT="$( cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd )"

TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/relay_verify_XXXXXX")"
TEST_PORT=8099
API_PID=""

echo "=========================================================="
echo "RELAY AI: Verifying Clean Installation"
echo "Target Temp Directory: $TEMP_DIR"
echo "=========================================================="

cleanup() {
    echo ""
    echo "Cleaning up verification processes..."
    if [ -n "$API_PID" ]; then
        kill "$API_PID" 2>/dev/null || true
        wait "$API_PID" 2>/dev/null || true
    fi
    rm -rf "$TEMP_DIR"
    echo "Temporary files removed. Done."
}
trap cleanup EXIT INT TERM

# Step 1: Copy clean repository files (excluding caches & node_modules)
echo "[1/5] Creating clean replica of repository..."
mkdir -p "$TEMP_DIR/relay"

if command -v rsync &>/dev/null; then
    rsync -a --exclude 'node_modules' \
             --exclude '.git' \
             --exclude '__pycache__' \
             --exclude '.pytest_cache' \
             --exclude 'dist' \
             "$REPO_ROOT/" "$TEMP_DIR/relay/"
else
    # Fallback to tar copy
    (cd "$REPO_ROOT" && tar --exclude='node_modules' --exclude='.git' --exclude='__pycache__' --exclude='.pytest_cache' --exclude='dist' -cf - .) | (cd "$TEMP_DIR/relay" && tar -xf -)
fi
echo "✓ Clean repository replica prepared."

# Step 2: Build frontend assets
echo "[2/5] Building frontend production bundle..."
cd "$TEMP_DIR/relay/web"
# Symlink or install node_modules for speed during verification
if [ -d "$REPO_ROOT/web/node_modules" ]; then
    ln -s "$REPO_ROOT/web/node_modules" "$TEMP_DIR/relay/web/node_modules"
else
    npm install --silent
fi
npm run build --silent
echo "✓ Frontend build completed successfully."

# Step 3: Launch backend API on isolated port
echo "[3/5] Starting isolated backend API on port $TEST_PORT..."
cd "$TEMP_DIR/relay/api"
export RELAY_DEMO_MODE=1
export PORT=$TEST_PORT

python3 -m uvicorn mock_server:app --host 127.0.0.1 --port "$TEST_PORT" > "$TEMP_DIR/api.log" 2>&1 &
API_PID=$!

# Wait for backend to be ready
HEALTH_URL="http://127.0.0.1:$TEST_PORT/health"
READY=0
for i in {1..20}; do
    if curl -s -f "$HEALTH_URL" > /dev/null 2>&1; then
        READY=1
        break
    fi
    sleep 0.3
done

if [ "$READY" -ne 1 ]; then
    echo "❌ ERROR: Backend failed to start on port $TEST_PORT within 6 seconds."
    echo "Backend log:"
    cat "$TEMP_DIR/api.log"
    exit 1
fi
echo "✓ Backend API is healthy and listening on port $TEST_PORT."

# Step 4: Run smoke test suite against running server
echo "[4/5] Executing smoke test against clean install..."

# 4a. Health endpoint
HEALTH_RESP=$(curl -s "$HEALTH_URL")
if ! echo "$HEALTH_RESP" | grep -q '"status"[[:space:]]*:[[:space:]]*"ok"'; then
    echo "❌ Health check failed: $HEALTH_RESP"
    exit 1
fi
echo "  ✓ Health endpoint returned status: ok"

# 4b. Cases listing
CASES_RESP=$(curl -s "http://127.0.0.1:$TEST_PORT/cases")
if ! echo "$CASES_RESP" | grep -q "case-001"; then
    echo "❌ Cases listing failed: $CASES_RESP"
    exit 1
fi
echo "  ✓ Cases endpoint returned case-001 (ShopLedger)"

# 4c. Demo login token generation
LOGIN_RESP=$(curl -s -X POST "http://127.0.0.1:$TEST_PORT/auth/demo-login" \
  -H "Content-Type: application/json" \
  -d '{"role":"engineering_lead","user_id":"elena@shopledger.dev","name":"Elena Vance"}')
TOKEN=$(echo "$LOGIN_RESP" | python3 -c "import sys, json; print(json.load(sys.stdin).get('token', ''))")

if [ -z "$TOKEN" ]; then
    echo "❌ Demo login failed to produce token: $LOGIN_RESP"
    exit 1
fi
echo "  ✓ Demo login produced signed HMAC token"

# 4d. Handover fetch with bearer token
HO_RESP=$(curl -s "http://127.0.0.1:$TEST_PORT/cases/case-001/handover" \
  -H "Authorization: Bearer $TOKEN")
if ! echo "$HO_RESP" | grep -q "items"; then
    echo "❌ Handover endpoint failed: $HO_RESP"
    exit 1
fi
echo "  ✓ Handover endpoint returned structured claims and citations"

# 4e. Ask the leaver endpoint
ASK_RESP=$(curl -s -X POST "http://127.0.0.1:$TEST_PORT/cases/case-001/ask" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"question":"What services does ShopLedger depend on?"}')
if ! echo "$ASK_RESP" | grep -q "answer"; then
    echo "❌ Ask the leaver endpoint failed: $ASK_RESP"
    exit 1
fi
echo "  ✓ Ask-the-leaver returned answer with role-gated citations"

# Step 5: Verification complete
echo "[5/5] Verification summary:"
echo "=========================================================="
echo "✓ ALL CLEAN INSTALL AND SMOKE TESTS PASSED!"
echo "✓ Fresh replica builds cleanly"
echo "✓ Uvicorn starts with zero errors"
echo "✓ Health, auth, handover, and Q&A endpoints verified"
echo "=========================================================="
